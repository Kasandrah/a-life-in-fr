views:
  - type: table
    name: Table
    filters:
      or:
        - file.folder == "020-One-Night-Plays"
        - file.folder == "070-Adventures/Arthurian-Britain"
        - file.folder == "070-Adventures/Dark-Ages"
        - file.folder == "070-Adventures/Modern/From-1878-to-1926"
        - file.folder == "070-Adventures/Modern/From-1983-to-1992"
        - file.folder == "070-Adventures/Modern/Nephilim"
        - file.folder == "070-Adventures/Modern/USMC"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - fc-date
      - fc-end
    sort:
      - property: fc-date
        direction: ASC
